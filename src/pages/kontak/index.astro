
---
import Layout from "../../layouts/Layout.astro";

const whatsapp = "6281265077222";
const whatsappUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent("Assalamu'alaikum, saya ingin mendapatkan informasi Keris Pusaka Institute.")}`;

const units = [
  {
    nama: "Unit Bantan",
    lokasi: "Bantan",
    deskripsi: "Informasi latihan dan kegiatan anggota.",
  },
  {
    nama: "Unit Sidorejo Hilir",
    lokasi: "Sidorejo Hilir",
    deskripsi: "Informasi latihan dan kegiatan anggota.",
  },
];

const sosialMedia = [
  {
    nama: "Instagram",
    username: "@kerispusakainstitute",
    url: "https://www.instagram.com/kerispusakainstitute/",
  },
  {
    nama: "TikTok",
    username: "@kerispusakacimacan",
    url: "https://www.tiktok.com/@kerispusakacimacan",
  },
];
---

<Layout
  title="Kontak | Keris Pusaka Institute"
  description="Hubungi Keris Pusaka Institute melalui WhatsApp, Instagram, TikTok, atau kunjungi sekretariat perguruan di Medan."
>
  <main class="contact-page">

    <!-- HERO -->
    <section class="contact-hero">
      <p class="eyebrow">HUBUNGI KAMI</p>
      <h1>Kontak <span>Keris Pusaka Institute</span></h1>
      <p>
        Kami siap membantu memberikan informasi mengenai perguruan,
        kegiatan, program latihan, dan pencak silat Keris Pusaka.
      </p>
    </section>

    <!-- WHATSAPP -->
    <section class="contact-card whatsapp-card">
      <div class="contact-icon">✆</div>
      <div class="contact-content">
        <span class="label">WHATSAPP RESMI</span>
        <h2>Hubungi Perguruan</h2>
        <p>0812-6507-7222</p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          Hubungi via WhatsApp ↗
        </a>
      </div>
    </section>

    <!-- SEKRETARIAT -->
    <section class="contact-card">
      <div class="contact-icon">⌖</div>
      <div class="contact-content">
        <span class="label">ALAMAT SEKRETARIAT</span>
        <h2>Kunjungi Sekretariat</h2>
        <p>
          Jalan M. Yakub Gang Iyem No. 2,<br />
          Kecamatan Medan Perjuangan,<br />
          Kota Medan, Sumatera Utara.
        </p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Jalan+M.+Yakub+Gang+Iyem+No.2+Medan+Perjuangan+Medan"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          Buka Google Maps ↗
        </a>
      </div>
    </section>

    <!-- UNIT LATIHAN -->
    <section class="units-section">
      <div class="section-heading">
        <p class="eyebrow">JARINGAN PERGURUAN</p>
        <h2>Unit Latihan</h2>
        <p>Temukan unit latihan Keris Pusaka Institute.</p>
      </div>

      <div class="units-grid">
        {units.map((unit) => (
          <article class="unit-card">
            <div class="contact-icon">⚔</div>
            <h3>{unit.nama}</h3>
            <p class="unit-location">📍 {unit.lokasi}</p>
            <p class="unit-description">{unit.deskripsi}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- MEDIA SOSIAL -->
    <section class="social-section">
      <div class="section-heading">
        <p class="eyebrow">IKUTI KAMI</p>
        <h2>Media Sosial Resmi</h2>
        <p>Ikuti dokumentasi kegiatan dan informasi perguruan.</p>
      </div>

      <div class="social-grid">
        {sosialMedia.map((media) => (
          <a
            href={media.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-card"
          >
            <div>
              <h3>{media.nama}</h3>
              <p>{media.username}</p>
            </div>
            <span>↗</span>
          </a>
        ))}
      </div>
    </section>

  </main>
</Layout>

<style>
  .contact-page {
    background: #020617;
    color: #f8fafc;
    padding: 60px 24px 90px;
    min-height: 100vh;
  }

  .contact-page section {
    max-width: 1024px;
    margin: 0 auto 28px;
  }

  .contact-hero {
    text-align: center;
    padding: 45px 20px;
  }

  .eyebrow {
    color: #34d399;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .contact-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    margin: 20px 0;
  }

  .contact-hero h1 span {
    color: #34d399;
  }

  .contact-hero > p:last-child,
  .section-heading > p:last-child {
    color: #94a3b8;
    line-height: 1.8;
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 18px;
    padding: 30px;
  }

  .whatsapp-card {
    border-color: #166534;
  }

  .contact-icon {
    font-size: 30px;
    color: #34d399;
    min-width: 40px;
  }

  .contact-content h2 {
    font-size: 24px;
    font-weight: 700;
    margin: 10px 0;
  }

  .contact-content p {
    color: #cbd5e1;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .label {
    color: #34d399;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .btn-whatsapp,
  .btn-outline {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.2s;
  }

  .btn-whatsapp {
    background: #16a34a;
    color: white;
  }

  .btn-whatsapp:hover {
    background: #15803d;
  }

  .btn-outline {
    border: 1px solid #34d399;
    color: #34d399;
  }

  .btn-outline:hover {
    background: #064e3b;
  }

  .section-heading {
    text-align: center;
    padding: 35px 0;
  }

  .section-heading h2 {
    font-size: 28px;
    font-weight: 700;
    margin: 15px 0;
  }

  .units-grid,
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .unit-card,
  .social-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 18px;
    padding: 25px;
  }

  .unit-card:hover,
  .social-card:hover {
    border-color: #34d399;
  }

  .unit-card h3,
  .social-card h3 {
    font-size: 20px;
    font-weight: 700;
  }

  .unit-location {
    color: #34d399;
    font-size: 14px;
    margin-top: 10px;
  }

  .unit-description,
  .social-card p {
    color: #94a3b8;
    line-height: 1.7;
    margin-top: 12px;
  }

  .social-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: #f8fafc;
    transition: 0.2s;
  }

  .social-card > span {
    color: #34d399;
    font-size: 22px;
  }

  @media (max-width: 640px) {
    .contact-page {
      padding: 35px 16px 60px;
    }

    .contact-hero {
      padding: 30px 5px;
    }

    .contact-card {
      padding: 22px;
      gap: 15px;
    }
  }
</style>
