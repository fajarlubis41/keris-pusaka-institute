
---
import Layout from "../../layouts/Layout.astro";

const articles = [
  {
    kategori: "KEGIATAN",
    judul: "Penampilan Pencak Silat Keris Pusaka Institute di Hari Guru Nasional 2026",
    deskripsi: "Anggota Keris Pusaka Institute memeriahkan peringatan Hari Guru Nasional 25 November 2026 melalui peragaan jurus pencak silat di SMP N 28 Medan, SMP N 23 Medan, dan SMP N 5 Percut Sei Tuan.",
    gambar: "/images/artikel/hari-guru-nasional-2026.webp",
    link: "/artikel/hari-guru-nasional-2026/"
  },
  {
    kategori: "KEGIATAN",
    judul: "Try Out Pencak Silat Keris Pusaka Institute 18 Oktober 2026",
    deskripsi: "Lebih dari 50 peserta mengikuti Try Out pencak silat Keris Pusaka Institute pada 18 Oktober 2026. Kegiatan turut dihadiri orang tua murid dan menggunakan aplikasi skor pencak silat digital.",
    gambar: "/images/galeri/try-out-18-10-2026/foto-01.webp",
    link: "/artikel/try-out-18-oktober-2026/"
  },
  {
    kategori: "KEGIATAN",
    judul: "Keris Pusaka Institute Bersama PPSI Sumut di Acara PPSI Tanjung Balai",
    deskripsi: "Anggota Keris Pusaka Institute menampilkan jurus perguruan dalam acara PPSI Tanjung Balai yang dihadiri Ketua PPSI Sumut Kang Edi Yusri, Sekretaris Faisal Lubis, dan Ketua Umum Keris Pusaka Institute Amrul Faisal Hasibuan.",
    gambar: "/images/galeri/keris-pusaka-institute-dengan-ppsi-sumut/foto-05.webp",
    link: "/artikel/keris-pusaka-institute-dengan-ppsi-sumut/"
  }
];
---

<Layout
  title="Artikel & Berita | Keris Pusaka Institute"
  description="Artikel dan dokumentasi kegiatan Keris Pusaka Institute."
>
  <main class="artikel-page">
    <section class="artikel-hero">
      <p class="eyebrow">INFORMASI PERGURUAN</p>
      <h1>Artikel & Berita</h1>
      <p>Informasi dan dokumentasi kegiatan Keris Pusaka Institute.</p>
    </section>

    
<section class="artikel-grid">
  {articles.map((article) => (
    <article class="artikel-card">
      <img
        src={article.gambar}
        alt={article.judul}
      />

      <div class="artikel-content">
        <span class="kategori">{article.kategori}</span>
        <h2>{article.judul}</h2>
        <p>{article.deskripsi}</p>
        <a href={article.link}>Baca Selengkapnya →</a>
      </div>
    </article>
  ))}
</section>

  </main>
</Layout>

<style>
  .artikel-page {
    background: #f8fafc;
    color: #0f172a;
    min-height: 100vh;
    padding: 60px 24px 90px;
  }

  .artikel-page section {
    max-width: 1140px;
    margin-inline: auto;
  }

  .artikel-hero {
    text-align: center;
    padding: 30px 20px 55px;
  }

  .eyebrow {
    color: #15803d;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .artikel-hero h1 {
    color: #14532d;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    margin: 18px 0;
  }

  .artikel-hero p:last-child {
    color: #64748b;
    line-height: 1.8;
  }

  .artikel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .artikel-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }

  .artikel-card:hover {
    border-color: #15803d;
    transform: translateY(-3px);
  }

  .artikel-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .artikel-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .kategori {
    color: #15803d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .artikel-content h2 {
    color: #14532d;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
    margin: 12px 0;
  }

  .artikel-content p {
    color: #475569;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .artikel-content a {
    color: #15803d;
    font-weight: 700;
    text-decoration: none;
    margin-top: auto;
  }

  .artikel-content a:hover {
    color: #166534;
  }

  @media (max-width: 900px) {
    .artikel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .artikel-page {
      padding: 35px 16px 60px;
    }

    .artikel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
