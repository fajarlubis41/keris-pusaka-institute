
---
import Layout from "../layouts/Layout.astro";


const articles = [
  {
    kategori: "KEGIATAN",
    judul: "Penampilan Pencak Silat Keris Pusaka Institute di Hari Guru Nasional 2026",
    deskripsi: "Anggota Keris Pusaka Institute memeriahkan peringatan Hari Guru Nasional 25 November 2026 melalui peragaan jurus pencak silat di SMP N 28 Medan, SMP N 23 Medan, dan SMP N 5 Percut Sei Tuan.",
    gambar: "/images/artikel/hari-guru-nasional-2026.webp",
    link: "/artikel/hari-guru-nasional-2026/"
  },
  {
    kategori: "KEGIATAN",
    judul: "Try Out Pencak Silat Keris Pusaka Institute 18 Oktober 2026",
    deskripsi: "Lebih dari 50 peserta mengikuti Try Out pencak silat Keris Pusaka Institute pada 18 Oktober 2026. Kegiatan turut dihadiri orang tua murid dan menggunakan aplikasi skor pencak silat digital.",
    gambar: "/images/galeri/try-out-18-10-2026/foto-01.webp",
    link: "/artikel/try-out-18-oktober-2026/"
  },
  {
    kategori: "KEGIATAN",
    judul: "Keris Pusaka Institute Bersama PPSI Sumut di Acara PPSI Tanjung Balai",
    deskripsi: "Anggota Keris Pusaka Institute menampilkan jurus perguruan dalam acara PPSI Tanjung Balai yang dihadiri Ketua PPSI Sumut Kang Edi Yusri, Sekretaris Faisal Lubis, dan Ketua Umum Keris Pusaka Institute Amrul Faisal Hasibuan.",
    gambar: "/images/galeri/keris-pusaka-institute-dengan-ppsi-sumut/foto-05.webp",
    link: "/artikel/keris-pusaka-institute-dengan-ppsi-sumut/"
  }
];

---

<Layout>
  <main>
    <section class="hero">
      <p class="eyebrow">Keris Pusaka Institute</p>

      <h1>
        Melestarikan Budaya,<br />
        Membentuk Generasi Berkarakter
      </h1>

      <p class="description">
        Mengenal seni bela diri tradisional, membangun disiplin,
        karakter, dan semangat persaudaraan melalui Pencak Silat.
      </p>

      
      <div class="sejarah-singkat">
        <h2>Sejarah Singkat Perguruan</h2>

        <p>
          Perguruan Pencak Silat Keris Pusaka didirikan oleh
          <strong>Kiyai Muhammad Yahya Wijaya Kesuma</strong>,
          berasal dari Banten. Perguruan ini diresmikan pada
          6 Juli 1988 di Desa Bakaran Batu, Kecamatan Batang Kuis,
          Kabupaten Deli Serdang, Provinsi Sumatera Utara.
        </p>

        <p>
          Sejak berdiri, Keris Pusaka berkomitmen mengembangkan
          dan melestarikan pencak silat sebagai seni budaya bangsa,
          sekaligus membina generasi yang terampil, disiplin,
          berakhlak luhur, dan berjiwa satria.
        </p>
      </div>

      <a href="/profil/" class="button">Kenali Perguruan</a>

    </section>
</main>
	<section class="profil">
	<div class="profil-container">
		<div class="profil-heading">
		<span class="label">Tentang Perguruan</span>
		<h2>Mengenal Keris Pusaka Institute</h2>
		<p>
			Wadah pembelajaran seni bela diri tradisional yang
			mengembangkan keterampilan, karakter, dan persaudaraan.
		</p>
		</div>

		<div class="profil-grid">
		<article class="profil-card">
			<img
			src="/images/logo-keris-pusaka.webp"
			alt="Logo Keris Pusaka Institute"
			/>
			<h3>Keris Pusaka Institute</h3>
			<p>
			Perguruan pencak silat yang menjadi wadah pembinaan
			generasi melalui latihan, kedisiplinan, dan nilai luhur.
			</p>
		</article>

		<article class="profil-card">
			<img
			src="/images/logo-cimacan.webp"
			alt="Logo Seni Bela Diri Aliran Cimacan"
			/>
			<h3>Seni Bela Diri Aliran Cimacan</h3>
			<p>
			Identitas aliran seni bela diri yang menjadi bagian
			dari pengenalan dan pembelajaran keilmuan perguruan.
			</p>
		</article>
		</div>

		<div class="nilai">
		<h3>Nilai yang Kami Junjung</h3>
		<div class="nilai-list">
			<span>Disiplin</span>
			<span>Persaudaraan</span>
			<span>Penghormatan</span>
			<span>Pelestarian Budaya</span>
		</div>
		</div>
	</div>
	</section>
	
	<section class="program">
	<div class="program-container">
		<div class="program-heading">
		<span class="label">PROGRAM PERGURUAN</span>
		<h2>Program Latihan Keris Pusaka</h2>
		<p>
			Mengembangkan kemampuan, prestasi, dan karakter
			melalui pembelajaran pencak silat.
		</p>
		</div>

		<div class="galeri-grid">
			<a href="/galeri/" class="galeri-item">
				<img src="/images/galeri/hari-guru-2026-smpn-5-ps-tuan/foto-01.webp" alt="Penampilan Hari Guru Nasional di SMP N 5 PS. Tuan" />
				<span>Penampilan Hari Guru Nasional 2026 - SMP N 5 PS. Tuan</span>
			</a>
			<a href="/galeri/" class="galeri-item">
				<img src="/images/galeri/hari-guru-2026-smpn-23-medan/foto-01.webp" alt="Penampilan Hari Guru Nasional di SMP N 23 Medan" />
				<span>Penampilan Hari Guru Nasional 2026 - SMP N 23 Medan</span>
			</a>
			<a href="/galeri/" class="galeri-item">
				<img src="/images/galeri/hari-guru-2026-smpn-28-medan/foto-01.webp" alt="Penampilan Hari Guru Nasional di SMP N 28 Medan" />
				<span>Penampilan Hari Guru Nasional 2026 - SMP N 28 Medan</span>
			</a>
		</div>

		<div style="text-align: center; margin-top: 32px;">
			<a href="/galeri/" class="button">
				Lihat Semua Galeri
			</a>
		</div>
	</div>
	</section>

	<section class="galeri">
	<div class="galeri-container">
		<div class="galeri-heading">
		<span class="label">DOKUMENTASI</span>
		<h2>Galeri Kegiatan</h2>
		<p>
			Mengabadikan perjalanan, kebersamaan, dan semangat
			keluarga besar Keris Pusaka Institute.
		</p>
		</div>

		<div class="galeri-grid">
		
<a href="/galeri/" class="galeri-item">
  <img src="/images/galeri/try-out-18-10-2026/foto-01.webp" alt="Kegiatan Try Out Keris Pusaka Institute 18 Oktober 2026" />
  <span>Try Out 18 Oktober 2026</span>
</a>
<a href="/galeri/" class="galeri-item">
  <img src="/images/galeri/tasyakuran-pencapaian-prestasi-murid/foto-01.webp" alt="Tasyakuran Pencapaian Prestasi Murid" />
  <span>Keris Pusaka Institute mengadakan tasyakuran atas prestasi murid</span>
</a>
<a href="/galeri/" class="galeri-item">
  <img src="/images/galeri/sumut-open-2026/foto-01.webp" alt="Sumut Open 2026" />
  <span>Keris Pusaka Institute mengikuti kejuaraan Sumut Open 2026</span>
</a>
		<a href="/galeri/" class="button" >
			Lihat Semua Galeri
		</a>
		</div>
	</div>
	</section>

	<section class="artikel">
	<div class="artikel-container">
		<div class="artikel-heading">
		<span class="label">INFORMASI PERGURUAN</span>
		<h2>Artikel & Berita</h2>
		<p>
			Informasi, kegiatan, dan wawasan seputar
			pencak silat Keris Pusaka Institute.
		</p>
		</div>

		<div class="artikel-grid">
		
{articles.map((article) => (
  <article class="artikel-card">
    <img
      src={article.gambar}
      alt={article.judul}
      class="artikel-thumbnail"
    />

    <span class="artikel-kategori">{article.kategori}</span>

    <h3>{article.judul}</h3>

    <p>{article.deskripsi}</p>

    <a href={article.link}>Baca Selengkapnya →</a>
  </article>
))}

		</div>
	</div>
	</section>

	<section class="kontak">
	<div class="kontak-container">
		<div class="kontak-heading">
		<span class="label">HUBUNGI KAMI</span>
		<h2>Bergabung Bersama Keris Pusaka</h2>
		<p>
			Mari belajar, berlatih, dan melestarikan pencak silat
			bersama keluarga besar Keris Pusaka Institute.
		</p>
		</div>

		<div class="kontak-card">
		<div class="kontak-info">
			<h3>Informasi Perguruan</h3>
			<p><strong>Nama:</strong> Keris Pusaka Institute</p>
			<p><strong>Aliran:</strong> Seni Bela Diri Aliran Cimacan</p>
			
		<div class="program-link">
		<a href="/unit-latihan/" class="program-button">
			Lihat Jadwal & Lokasi Unit Latihan
		</a>
		</div>

		</div>

		<div class="kontak-action">
			<h3>Ingin Bergabung?</h3>
			<p>Hubungi pengurus untuk informasi latihan dan pendaftaran anggota.</p>
			<a
			href="https://wa.me/6281265077222"
			class="button"
			target="_blank"
			rel="noopener noreferrer"
			>
			Hubungi WhatsApp
			</a>
		</div>
		</div>
	</div>
	</section>

	<style>
	.profil {
		padding: 80px 24px;
		background: white;
	}

	.profil-container {
		max-width: 1100px;
		margin: auto;
	}

	.profil-heading {
		max-width: 700px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.label {
		color: #15803d;
		font-weight: bold;
		letter-spacing: 2px;
		text-transform: uppercase;
		font-size: 13px;
	}

	.profil-heading h2 {
		color: #14532d;
		font-size: clamp(28px, 4vw, 40px);
		margin: 16px 0;
	}

	.profil-heading p {
		color: #64748b;
		line-height: 1.8;
	}

	.profil-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.profil-card {
		padding: 32px;
		background: #f0fdf4;
		border: 1px solid #dcfce7;
		border-radius: 20px;
		text-align: center;
	}

	.profil-card img {
		width: 90px;
		height: 90px;
		object-fit: contain;
	}

	.profil-card h3 {
		color: #166534;
		margin: 20px 0 12px;
	}

	.profil-card p {
		color: #475569;
		line-height: 1.8;
	}

	.nilai {
		margin-top: 56px;
		text-align: center;
	}

	.nilai h3 {
		color: #14532d;
		margin-bottom: 24px;
	}

	.nilai-list {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.nilai-list span {
		padding: 12px 20px;
		background: #dcfce7;
		color: #166534;
		border-radius: 50px;
		font-weight: 600;
	}

	@media (max-width: 650px) {
		.profil {
		padding: 56px 20px;
		}

		.profil-grid {
		grid-template-columns: 1fr;
		}
	}
	</style>

</Layout>

<style>
  main {
    padding: 24px;
  }

  .hero {
    max-width: 1000px;
    margin: 60px auto;
    padding: 80px 24px;
    text-align: center;
    background: #f0fdf4;
    border-radius: 24px;
  }

  .eyebrow {
    color: #15803d;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 {
    color: #14532d;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.2;
  }

  .description {
    max-width: 650px;
    margin: 24px auto;
    color: #475569;
    line-height: 1.8;
  }

  .button {
    display: inline-block;
    padding: 14px 24px;
    background: #15803d;
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: bold;
  }

  .button:hover {
    background: #166534;
  }

  .program {
    padding: 80px 24px;
    background: #f8fafc;
  }

  .program-container {
    max-width: 1100px;
    margin: auto;
  }

  .program-heading {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .program-heading h2 {
    color: #14532d;
    font-size: clamp(28px, 4vw, 40px);
    margin: 16px 0;
  }

  .program-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .program-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .program-card {
    padding: 32px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .program-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgb(0 0 0 / 8%);
  }

  .program-card h3 {
    color: #166534;
    margin-top: 0;
  }

  .program-card p {
    color: #475569;
    line-height: 1.8;
  }

  @media (max-width: 800px) {
    .program-grid {
      grid-template-columns: 1fr;
    }

    .program {
      padding: 56px 20px;
    }
  }

  .galeri {
    padding: 80px 24px;
    background: white;
  }

  .galeri-container {
    max-width: 1100px;
    margin: auto;
  }

  .galeri-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .galeri-heading h2 {
    color: #14532d;
    font-size: clamp(28px, 4vw, 40px);
    margin: 16px 0;
  }

  .galeri-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .galeri-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .galeri-item {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: #dcfce7;
    aspect-ratio: 4 / 3;
  }

  .galeri-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .galeri-item:hover img {
    transform: scale(1.05);
  }

  .galeri-item span {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    color: white;
    font-weight: bold;
    background: linear-gradient(transparent, rgb(0 0 0 / 75%));
  }

  @media (max-width: 800px) {
    .galeri-grid {
      grid-template-columns: 1fr;
    }

    .galeri {
      padding: 56px 20px;
    }
  }

  .artikel {
    padding: 80px 24px;
    background: #f8fafc;
  }

  .artikel-container {
    max-width: 1100px;
    margin: auto;
  }

  .artikel-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .artikel-heading h2 {
    color: #14532d;
    font-size: clamp(28px, 4vw, 40px);
    margin: 16px 0;
  }

  .artikel-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .artikel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .artikel-card {
    padding: 32px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
  }

  .artikel-kategori {
    color: #15803d;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
  }

  .artikel-card h3 {
    color: #14532d;
    margin: 16px 0;
  }

  .artikel-card p {
    color: #475569;
    line-height: 1.8;
  }

  .artikel-card a {
    display: inline-block;
    margin-top: 16px;
    color: #15803d;
    font-weight: bold;
    text-decoration: none;
  }

  .artikel-card a:hover {
    color: #166534;
  }

  @media (max-width: 800px) {
    .artikel-grid {
      grid-template-columns: 1fr;
    }

    .artikel {
      padding: 56px 20px;
    }
  }

  .kontak {
    padding: 80px 24px;
    background: white;
  }

  .kontak-container {
    max-width: 1000px;
    margin: auto;
  }

  .kontak-heading {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .kontak-heading h2 {
    color: #14532d;
    font-size: clamp(28px, 4vw, 40px);
    margin: 16px 0;
  }

  .kontak-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .kontak-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 40px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 24px;
  }

  .kontak-card h3 {
    color: #166534;
    margin-top: 0;
  }

  .kontak-info p,
  .kontak-action p {
    color: #475569;
    line-height: 1.8;
  }

  .kontak-action {
    padding: 24px;
    background: white;
    border-radius: 16px;
  }

  .kontak-action .button {
    display: inline-block;
    margin-top: 16px;
    padding: 14px 24px;
    background: #15803d;
    color: white;
    border-radius: 10px;
    font-weight: bold;
    text-decoration: none;
  }

  .kontak-action .button:hover {
    background: #166534;
  }

  @media (max-width: 700px) {
    .kontak-card {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .kontak {
      padding: 56px 20px;
    }
  }

.program-link {
  text-align: center;
  margin-top: 32px;
}

.program-button {
  display: inline-block;
  background: #15803d;
  color: white;
  padding: 14px 24px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: bold;
}

.program-button:hover {
  background: #166534;
}

.artikel-thumbnail {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 20px;
}

.sejarah-singkat {
  max-width: 750px;
  margin: 40px auto 30px;
  padding: 25px;
  background: white;
  border: 1px solid #bbf7d0;
  border-radius: 16px;
  text-align: left;
}

.sejarah-singkat h2 {
  color: #14532d;
  text-align: center;
  margin-top: 0;
  margin-bottom: 20px;
}

.sejarah-singkat p {
  color: #475569;
  line-height: 1.8;
  margin-bottom: 15px;
}

.sejarah-singkat p:last-child {
  margin-bottom: 0;
}

</style>
