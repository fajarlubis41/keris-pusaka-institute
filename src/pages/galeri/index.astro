---

<Layout title="Galeri | Keris Pusaka Institute">
  <section class="galeri-hero">
    <p class="eyebrow">DOKUMENTASI PERGURUAN</p>
    <h1>Galeri Keris Pusaka Institute</h1>
    <p>
      Mengabadikan perjalanan, kegiatan latihan, dan kebersamaan
      keluarga besar Keris Pusaka Institute.
    </p>
  </section>

  <section class="galeri-section">
    <div class="album-grid">
      {albums.map((album, index) => (
        <article class="album-card">
          <div class="album-cover">
            <img src={album.cover} alt={album.title} loading="lazy" />
            <span class="photo-count">{album.jumlah}</span>
          </div>

          <div class="album-content">
            <h2>{album.title}</h2>
            <p>{album.description}</p>
            <button
                class="album-button"
                data-album={`album-${index}`}
            >
                Lihat Album →
            </button>
          </div>
        </article>
      
      ))}
    </div>

    {albums.map((album, index) => (
      <dialog id={`album-${index}`} class="album-dialog">
        <div class="dialog-header">
          <h2>{album.title}</h2>
          <button
            class="close-button"
            aria-label="Tutup album"
          >
            ✕
          </button>
        </div>

        
<div class="photo-grid">
  {album.photos.map((photo, photoIndex) => (
    <img
      src={photo}
      alt={`${album.title} foto ${photoIndex + 1}`}
      loading="lazy"
    />
  ))}
</div>

      </dialog>
    ))}
  </section>

<div id="photo-lightbox" class="photo-lightbox">
  <button id="lightbox-close" class="lightbox-close" aria-label="Tutup foto">
    ✕
  </button>

  <button id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Foto sebelumnya">
    ❮
  </button>

  <img id="lightbox-image" src="" alt="Foto galeri" />

  <button id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Foto berikutnya">
    ❯
  </button>
</div>

</Layout>


<style>
  .galeri-hero {
    padding: 80px 24px 60px;
    text-align: center;
    background: #f8fafc;
  }

  .eyebrow {
    color: #15803d;
    font-weight: bold;
    letter-spacing: 3px;
    font-size: 14px;
  }

  .galeri-hero h1 {
    color: #14532d;
    font-size: clamp(30px, 5vw, 48px);
    font-weight: bold;
    margin: 20px 0;
  }

  .galeri-hero p:last-child {
    max-width: 700px;
    margin: auto;
    color: #64748b;
    line-height: 1.8;
  }

  .galeri-section {
    max-width: 1200px;
    margin: auto;
    padding: 60px 24px 80px;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .album-card {
    overflow: hidden;
    border: 1px solid #bbf7d0;
    border-radius: 18px;
    background: #f0fdf4;
  }

  .album-cover {
    position: relative;
    height: 230px;
    background: #dcfce7;
  }

  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-count {
    position: absolute;
    bottom: 12px;
    right: 12px;
    padding: 7px 12px;
    background: #14532d;
    color: white;
    border-radius: 8px;
    font-size: 13px;
  }

  .album-content {
    padding: 24px;
  }

  .album-content h2 {
    color: #166534;
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 12px;
  }

  .album-content p {
    color: #64748b;
    font-size: 14px;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .album-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .album-grid {
      grid-template-columns: 1fr;
    }

    .galeri-hero {
      padding: 60px 20px 45px;
    }

    .galeri-section {
      padding: 40px 20px 60px;
    }
  }

.album-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  margin-top: 12px;
  background: #15803d;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.album-button:hover {
  background: #166534;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(21, 128, 61, 0.2);
}

.album-dialog {
  width: min(900px, 90%);
  max-height: 85vh;
  padding: 24px;
  border: none;
  border-radius: 20px;
  background: #ffffff;
  color: #14532d;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.album-dialog::backdrop {
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.dialog-header h2 {
  font-size: 24px;
  margin: 0;
}

.close-button {
  border: none;
  background: #dc2626;
  color: white;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.photo-grid img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 12px;
}

@media (max-width: 600px) {
  .photo-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .photo-grid img {
    height: 150px;
  }

  .album-dialog {
    padding: 16px;
  }
}

.photo-lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.95);
  align-items: center;
  justify-content: center;
}

.photo-lightbox.active {
  display: flex;
}

.photo-lightbox img {
  max-width: 85%;
  max-height: 85vh;
  object-fit: contain;
  border-radius: 12px;
}

.lightbox-close {
  position: absolute;
  top: 25px;
  right: 30px;
  background: #dc2626;
  color: white;
  border: none;
  border-radius: 50%;
  width: 45px;
  height: 45px;
  font-size: 24px;
  cursor: pointer;
}

.lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: none;
  font-size: 35px;
  padding: 15px;
  cursor: pointer;
  border-radius: 10px;
}

.lightbox-prev {
  left: 20px;
}

.lightbox-next {
  right: 20px;
}

@media (max-width: 600px) {
  .photo-lightbox img {
    max-width: 95%;
  }

  .lightbox-nav {
    font-size: 25px;
    padding: 10px;
  }
}

</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".album-button").forEach((button) => {
    button.addEventListener("click", () => {
      const albumId = button.dataset.album;
      const dialog = albumId
        ? document.getElementById(albumId) as HTMLDialogElement | null
        : null;

      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".close-button").forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = button.closest("dialog") as HTMLDialogElement | null;
      dialog?.close();
    });
  });
  
</script>

<script>
  const lightbox = document.getElementById("photo-lightbox");
  const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement;
  const lightboxClose = document.getElementById("lightbox-close") as HTMLButtonElement;
  const lightboxPrev = document.getElementById("lightbox-prev") as HTMLButtonElement;
  const lightboxNext = document.getElementById("lightbox-next") as HTMLButtonElement;

  let currentPhotos: string[] = [];
  let currentPhotoIndex = 0;

  function showLightboxPhoto() {
    if (!lightboxImage || currentPhotos.length === 0) return;
    lightboxImage.src = currentPhotos[currentPhotoIndex];
  }

  document.querySelectorAll<HTMLImageElement>(".photo-grid img").forEach((img) => {
    img.addEventListener("click", () => {
      const grid = img.closest(".photo-grid");
      if (!grid || !lightbox) return;

      const photos = Array.from(
        grid.querySelectorAll<HTMLImageElement>("img")
      );

      currentPhotos = photos.map((photo) => photo.src);
      currentPhotoIndex = photos.indexOf(img);

      showLightboxPhoto();
      lightbox.classList.add("active");
    });
  });

  lightboxClose?.addEventListener("click", () => {
    lightbox?.classList.remove("active");
  });

  lightboxPrev?.addEventListener("click", () => {
    if (currentPhotos.length === 0) return;

    currentPhotoIndex =
      (currentPhotoIndex - 1 + currentPhotos.length) % currentPhotos.length;

    showLightboxPhoto();
  });

  lightboxNext?.addEventListener("click", () => {
    if (currentPhotos.length === 0) return;

    currentPhotoIndex =
      (currentPhotoIndex + 1) % currentPhotos.length;

    showLightboxPhoto();
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox?.classList.contains("active")) return;

    if (event.key === "Escape") {
      lightbox.classList.remove("active");
    }

    if (event.key === "ArrowLeft") lightboxPrev?.click();
    if (event.key === "ArrowRight") lightboxNext?.click();
  });
</script>
