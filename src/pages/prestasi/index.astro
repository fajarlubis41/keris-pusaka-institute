    border-color: #15803d;
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
  }

  .rekap-icon {
    font-size: 28px;
    margin-bottom: 6px;
  }

  .rekap-angka {
    font-size: 32px;
    font-weight: 900;
    color: #14532d;
    line-height: 1.1;
  }

