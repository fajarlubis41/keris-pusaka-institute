const totalEmas = daftarPrestasi.filter((item) => item.medali === "Emas").length;
const totalPerak = daftarPrestasi.filter((item) => item.medali === "Perak").length;
const totalPerunggu = daftarPrestasi.filter((item) => item.medali === "Perunggu").length;
const totalSemua = daftarPrestasi.length;

// Ambil daftar kejuaraan unik untuk dropdown filter
const daftarKejuaraan = [...new Set(daftarPrestasi.map((item) => item.kejuaraan))];
---

<Layout
  title="Prestasi & Rekap Medali Atlet | Keris Pusaka Institute"
  description="Daftar prestasi kejuaraan dan rekap perolehan medali atlet pencak silat Keris Pusaka Institute dari berbagai unit latihan dan ekstrakurikuler sekolah."
>
  <section class="prestasi-hero">
    <p class="eyebrow">HALL OF FAME & PRESTASI</p>
    <h1>Etalase Prestasi Atlet</h1>
    <p>
      Bukti nyata pembinaan teknik, fisik, dan mental juara murid-murid
      Keris Pusaka Institute di berbagai ajang kejuaraan pencak silat.
    </p>

    <!-- Kotak Rekapitulasi Medali Otomatis -->
    <div class="rekap-grid">
      <div class="rekap-card emas">
        <span class="rekap-icon">🥇</span>
        <strong class="rekap-angka">{totalEmas}</strong>
        <span class="rekap-label">Medali Emas</span>
      </div>
      <div class="rekap-card perak">
        <span class="rekap-icon">🥈</span>
        <strong class="rekap-angka">{totalPerak}</strong>
        <span class="rekap-label">Medali Perak</span>
      </div>
      <div class="rekap-card perunggu">
        <span class="rekap-icon">🥉</span>
        <strong class="rekap-angka">{totalPerunggu}</strong>
        <span class="rekap-label">Medali Perunggu</span>
      </div>
      <div class="rekap-card total">
        <span class="rekap-icon">🏆</span>
        <strong class="rekap-angka">{totalSemua}</strong>
        <span class="rekap-label">Total Penghargaan</span>
      </div>
    </div>
  </section>

  <section class="prestasi-section">
    <!-- Bar Filter Medali & Kejuaraan -->
    <div class="filter-bar">
      <div class="filter-pills" id="medal-filters">
        <button class="pill-btn active" data-medali="semua">Semua ({totalSemua})</button>
        <button class="pill-btn" data-medali="Emas">🥇 Emas ({totalEmas})</button>
        <button class="pill-btn" data-medali="Perak">🥈 Perak ({totalPerak})</button>
        <button class="pill-btn" data-medali="Perunggu">🥉 Perunggu ({totalPerunggu})</button>
      </div>

      <select id="kejuaraan-filter" class="kejuaraan-select" aria-label="Filter berdasarkan kejuaraan">
        <option value="semua">Semua Kejuaraan</option>
        {daftarKejuaraan.map((kej) => (
          <option value={kej}>{kej}</option>
        ))}
      </select>
    </div>

    <!-- Grid Daftar Juara -->
    <div class="juara-grid" id="juara-grid">
      {daftarPrestasi.map((item) => {
        const badgeClass =
          item.medali === "Emas"
            ? "badge-emas"
            : item.medali === "Perak"
            ? "badge-perak"
            : "badge-perunggu";

        const badgeText =
          item.medali === "Emas"
            ? "🥇 JUARA 1 • EMAS"
            : item.medali === "Perak"
            ? "🥈 JUARA 2 • PERAK"
            : "🥉 JUARA 3 • PERUNGGU";

        return (
          <article
            class="juara-card"
            data-medali={item.medali}
            data-kejuaraan={item.kejuaraan}
          >
            <div class="juara-foto-wrap">
              <img
                src={item.foto}
                alt={`${item.nama} - ${item.medali} ${item.kejuaraan}`}
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/logo-keris-pusaka.webp'; this.classList.add('fallback-logo');"
              />
              <span class={`medali-badge ${badgeClass}`}>{badgeText}</span>
            </div>

            <div class="juara-body">
              <span class="juara-asal">🏫 {item.asal}</span>
              <h2>{item.nama}</h2>
              <p class="juara-kategori">{item.kategori}</p>
              <div class="juara-event">
                <span>{item.kejuaraan}</span>
                <span class="tahun-tag">{item.tahun}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p id="empty-state" class="empty-state" style="display: none;">
      Belum ada data prestasi untuk kombinasi filter tersebut.
    </p>

    <!-- Ajakan Kerja Sama Ekskul & Pendaftaran Murid -->
    <div class="cta-box">
      <div class="cta-text">
        <span class="cta-eyebrow">KERJA SAMA & PEMBINAAN</span>
        <h2>Ingin Membuka Ekskul Pencak Silat di Sekolah atau Mendaftarkan Putra-Putri Anda?</h2>
        <p>
          Keris Pusaka Institute siap bermitra dengan pihak sekolah maupun membina generasi muda
          menjadi atlet berprestasi dan berkarakter luhur.
        </p>
      </div>
      <div class="cta-actions">
        <a
          href="https://wa.me/6281265077222?text=Halo%20pengurus%20Keris%20Pusaka%20Institute,%20saya%20ingin%20bertanya%20seputar%20pendaftaran%20/%20kerja%20sama%20ekskul."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-wa"
        >
          Hubungi Pengurus via WhatsApp
        </a>
        <a href="/unit-latihan/" class="btn-lokasi">
          Lihat Lokasi Unit Latihan
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .prestasi-hero {
