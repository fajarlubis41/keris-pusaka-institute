    flex-wrap: wrap;
    gap: 10px;
  }

  .pill-btn {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill-btn:hover {
    border-color: #15803d;
    color: #15803d;
  }

