  }

  @media (max-width: 900px) {
    .rekap-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .juara-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .prestasi-hero {
      padding: 55px 20px 45px;
    }

