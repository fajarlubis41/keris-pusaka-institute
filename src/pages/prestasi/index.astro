</style>

<script>
  const pillButtons = document.querySelectorAll<HTMLButtonElement>(".pill-btn");
  const kejuaraanSelect = document.getElementById("kejuaraan-filter") as HTMLSelectElement | null;
  const juaraCards = document.querySelectorAll<HTMLElement>(".juara-card");
  const emptyState = document.getElementById("empty-state");

  let selectedMedali = "semua";
  let selectedKejuaraan = "semua";

  function filterPrestasi() {
    let visibleCount = 0;

    juaraCards.forEach((card) => {
      const cardMedali = card.dataset.medali || "";
      const cardKejuaraan = card.dataset.kejuaraan || "";

      const matchMedali = selectedMedali === "semua" || cardMedali === selectedMedali;
      const matchKejuaraan = selectedKejuaraan === "semua" || cardKejuaraan === selectedKejuaraan;

      if (matchMedali && matchKejuaraan) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  pillButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      pillButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      selectedMedali = btn.dataset.medali || "semua";
      filterPrestasi();
    });
  });

  kejuaraanSelect?.addEventListener("change", () => {
    selectedKejuaraan = kejuaraanSelect.value;
    filterPrestasi();
  });
</script>