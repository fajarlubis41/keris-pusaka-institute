
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Pencak Silat Keris Pusaka Institute",
  description = "Website resmi Keris Pusaka Institute, perguruan pencak silat yang melestarikan budaya, disiplin, dan prestasi."
} = Astro.props;

---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="disfora-site-verification" content="d09b2252d64921b535a94867865985c1">
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Keris Pusaka Institute",
      "url": "https://kerispusakainstitute.com/",
      "logo": "https://kerispusakainstitute.com/images/logo-keris-pusaka.webp",
      "description": "Perguruan pencak silat Keris Pusaka Institute yang melestarikan budaya, disiplin, dan prestasi.",
      "sameAs": [
        "https://www.instagram.com/kerispusakainstitute/",
        "https://www.tiktok.com/@kerispusakacimacan"
      ]
    })} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/webp" href="/images/logo-keris-pusaka.webp" />
    <title>{title}</title>
  </head>
  <body>
	<Header />
	<slot />
	<Footer />
  <script src="https://disfora.com/public/disfora.js" async></script>
 </body>
</html>

<style>
  html {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8fafc;
  }

  body {
    margin: 0;
    min-width: 320px;
  }
</style>
